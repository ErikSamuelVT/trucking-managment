# ============================================================
# TruckingControl — variables de entorno locales
# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA debe commitearse.
# ============================================================

# --- Supabase: expuestas al navegador ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: solo servidor (no usar prefijo NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
